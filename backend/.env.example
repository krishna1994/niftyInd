# Copy this file to `.env` (same directory) and fill in the values you need.
# `.env` is gitignored — your secrets will never be committed.
#
# The app works perfectly fine with NO .env file at all — every integration
# below is fully optional and gracefully disables itself when not configured.

# ── Zerodha Kite Connect (optional) ─────────────────────────────────────────
# Get these from https://developers.kite.trade/ (requires an active Zerodha
# trading account + the Kite Connect API subscription).
# Leave blank / omit to keep Zerodha integration disabled.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=

# The Kite Connect app's "Redirect URL" setting on developers.kite.trade
# should point to wherever your frontend handles the OAuth callback, e.g.:
#   http://localhost:3000/zerodha/callback
# (No env var needed for this — it's configured directly on the Kite
# Connect developer console, and the frontend reads the request_token from
# the URL when Zerodha redirects back.)

# ── Server ───────────────────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000